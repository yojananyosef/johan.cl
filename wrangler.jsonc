{
  "name": "johan-cl",
  "main": "@astrojs/cloudflare/entrypoints/server",
  // Fecha acotada al workerd empaquetado por wrangler (evita ERR_RUNTIME_FAILURE)
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat"],
  // Custom domains: la zona johan.cl debe estar en esta cuenta de Cloudflare.
  // www.johan.cl lo maneja el worker de redirección (workers/www-redirect).
  "routes": [{ "pattern": "johan.cl", "custom_domain": true }],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      // Contador de lecturas por artículo (clave: views:<slug>)
      // Sin "id": Wrangler auto-provisiona el namespace en el primer deploy
      "binding": "VIEWS"
    }
  ]
}
