---
// DIRECTORIO GENERAL DEL BLOG: listado por fecha, tags y acceso al buscador.
export const prerender = true

import { getCollection } from 'astro:content'
import BaseLayout from '../../components/BaseLayout.astro'
import PostCard from '../../components/PostCard.astro'
import { collectTags } from '../../utils/tags'

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
)
const tags = collectTags(posts)
const hasMore = posts.length > 6
---

<BaseLayout title="Blog" description="Notas de tecnología y teología.">
	<section class="py-24">
		<div class="mx-auto w-full max-w-[75rem] px-6 md:px-8">
			<div class="flex flex-wrap items-end justify-between gap-6">
				<div>
					<h1 class="display-lg">Blog</h1>
					<p class="mt-3 text-body">Notas sobre tecnología y teología.</p>
				</div>
				<button type="button" class="btn-secondary" data-search-open>
					<svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<circle cx="11" cy="11" r="7"></circle>
						<path d="m20 20-3.5-3.5"></path>
					</svg>
					Buscar
					<span class="ml-1 text-xs text-muted" aria-hidden="true">⌘K</span>
				</button>
			</div>

			{
				tags.length > 0 && (
					<ul class="mt-8 flex flex-wrap gap-2" role="list" aria-label="Etiquetas">
						{tags.map(({ tag, slug, count }) => (
							<li>
								<a href={`/tags/${slug}`} class="badge-pill transition-colors hover:bg-surface-strong">
									{tag} <span class="text-muted">{count}</span>
								</a>
							</li>
						))}
					</ul>
				)
			}

			{
				posts.length > 0 ? (
					<ul class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3" role="list">
						{posts.slice(0, 6).map((post) => (
							<li>
								<PostCard post={post} />
							</li>
						))}
					</ul>
				) : (
					<div class="wire-box mt-12 p-12 text-center">
						<p class="text-body">Aún no hay notas publicadas.</p>
						<p class="mt-2 text-sm text-muted">
							Escribe en <code class="font-mono text-xs">src/content/blog/</code> y aparecerán aquí.
						</p>
					</div>
				)
			}

			{
				hasMore && (
					<div class="mt-12 flex justify-center">
						<a href="/blog/page/2" class="btn-secondary">
							Página siguiente →
						</a>
					</div>
				)
			}
		</div>
	</section>
</BaseLayout>
