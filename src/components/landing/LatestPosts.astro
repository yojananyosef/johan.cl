---
// Los 3 posts más recientes publicados; completa el grid con tiles wireframe.
import { getCollection } from 'astro:content'
import FormattedDate from '../FormattedDate.astro'

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3)

const placeholders = Array.from({ length: Math.max(0, 3 - posts.length) })
---

<section class="bg-surface-soft py-24">
	<div class="mx-auto w-full max-w-[75rem] px-6 md:px-8">
		<div class="flex items-end justify-between gap-6">
			<h2 class="display-lg">Últimas notas</h2>
			<a href="/blog" class="text-link text-sm">Ver todas</a>
		</div>

		<ul class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3" role="list">
			{
				posts.map((post) => (
					<li class="relative flex h-full flex-col rounded-lg border border-hairline bg-canvas p-8 transition-colors hover:border-muted-soft">
						<a href={`/blog/${post.id}`} class="flex h-full flex-col after:absolute after:inset-0 after:rounded-lg after:content-['']">
							<p class="text-sm text-muted">
								<FormattedDate date={post.data.pubDate} />
							</p>
							<h3 class="display-sm mt-3">{post.data.title}</h3>
							<p class="mt-3 text-sm text-body">{post.data.description}</p>
						</a>
					</li>
				))
			}
			{
				placeholders.map(() => (
					<li class="rounded-lg border border-hairline bg-canvas p-8" aria-hidden="true">
						<span class="wire-line block w-24 opacity-70" style="height: 0.6rem;" />
						<span class="wire-line mt-4 block w-3/4" />
						<span class="wire-line mt-4 block w-full opacity-60" />
						<span class="wire-line mt-2 block w-2/3 opacity-60" />
					</li>
				))
			}
		</ul>
	</div>
</section>
