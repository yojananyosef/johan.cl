---
// Grid de proyectos (tiles estilo connector-tile). Sin datos: 3 tiles wireframe.
// Los datos provienen de site.projects — los subdominios (*.johan.cl) se agregan ahí.
import { site } from '../../data/site'

const statusBadge: Record<string, string> = {
	live: 'badge-primary',
	mvp: 'badge-pill',
	wip: 'badge-pill',
}

const placeholders = [0, 1, 2]
---

<section id="proyectos" class="py-24">
	<div class="mx-auto w-full max-w-[75rem] px-6 md:px-8">
		<h2 class="display-lg">
			{
				site.projects.length > 0 ? (
					'Proyectos'
				) : (
					<span class="wire-line block w-52" style="height: 2rem;" aria-hidden="true" />
				)
			}
		</h2>

		<ul class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3" role="list">
			{
				site.projects.length > 0
					? site.projects.map((project) => (
							<li class="rounded-lg border border-hairline p-5 transition-colors hover:border-muted-soft">
								<div class="flex items-center justify-between gap-3">
									<a
										href={project.url}
										class="text-base font-medium text-ink hover:underline"
										rel="noopener noreferrer"
									>
										{project.name}
									</a>
									<span class={statusBadge[project.status] ?? 'badge-pill'}>{project.status}</span>
								</div>
								<p class="mt-2 text-sm text-body">{project.description}</p>
								<p class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm">
									<a href={project.url} class="text-link" rel="noopener noreferrer">
										Abrir app →
									</a>
									{project.repo && (
										<a href={project.repo} class="text-link" rel="noopener noreferrer">
											Repositorio →
										</a>
									)}
								</p>
							</li>
						))
					: placeholders.map(() => (
							<li class="rounded-lg border border-hairline p-5" aria-hidden="true">
								<div class="flex items-center justify-between">
									<span class="wire-line block w-28 opacity-80" />
									<span class="wire-chip" />
								</div>
								<span class="wire-line mt-4 block w-full opacity-60" />
								<span class="wire-line mt-2 block w-2/3 opacity-60" />
							</li>
						))
			}
		</ul>
	</div>
</section>
