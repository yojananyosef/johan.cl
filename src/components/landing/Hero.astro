---
// Hero 6/6: nombre + titular (wireframe si no hay dato) a la izquierda,
// tarjeta de ilustración wireframe a la derecha.
import { site } from '../../data/site'
---

<section class="py-24">
	<div class="mx-auto grid w-full max-w-[75rem] grid-cols-1 items-center gap-12 px-6 md:px-8 lg:grid-cols-2">
		<div>
			<p class="badge-pill">{site.domain}</p>
			<h1 class="display-xl mt-6">{site.name}</h1>
			{
				site.bio ? (
					<p class="display-sm mt-6 max-w-[34rem] leading-[1.35]">{site.bio}</p>
				) : (
					<span class="mt-6 block" aria-hidden="true">
						<span class="wire-line block w-full max-w-md" style="height: 1.75rem;" />
					</span>
				)
			}
			{
				site.headline && <p class="display-md mt-4 text-ink">{site.headline}</p>
			}
			<div class="mt-6 max-w-md">
				{
					site.subheadline ? (
						<p class="text-body">{site.subheadline}</p>
					) : site.bio.length === 0 ? (
						<div aria-hidden="true" class="space-y-2.5">
							<span class="wire-line block w-full" />
							<span class="wire-line block w-11/12" />
							<span class="wire-line block w-2/3" />
						</div>
					) : null
				}
			</div>
			<div class="mt-10 flex flex-wrap items-center gap-3">
				<a href="/blog" class="btn-primary">Ir al blog</a>
				<a href="#proyectos" class="btn-secondary">Proyectos</a>
			</div>
		</div>

		<div class="wire-box aspect-[4/3] p-8" aria-hidden="true">
			<div class="flex h-full flex-col justify-end gap-3">
				<span class="wire-line block w-1/3 opacity-80" style="height: 0.5rem;" />
				<span class="wire-line block w-full" />
				<span class="wire-line block w-5/6" />
			</div>
		</div>
	</div>
</section>
