---
// Hero 6/6: nombre + titular (wireframe si no hay dato) a la izquierda,
// tarjeta de ilustración wireframe a la derecha.
import { site } from '../../data/site'
---

<section class="py-24">
	<div class="mx-auto grid w-full max-w-[75rem] grid-cols-1 items-center gap-12 px-6 md:px-8 lg:grid-cols-2">
		<div>
			<h1 class="display-xl">{site.name}</h1>
			{
				site.bio ? (
					<p class="display-sm mt-6 max-w-[34rem] leading-[1.35]">{site.bio}</p>
				) : (
					<span class="mt-6 block" aria-hidden="true">
						<span class="wire-line block w-full max-w-md" style="height: 1.75rem;" />
					</span>
				)
			}
			{
				site.headline && <p class="display-md mt-4 text-ink">{site.headline}</p>
			}
			<div class="mt-6 max-w-md">
				{
					site.subheadline ? (
						<p class="text-body">{site.subheadline}</p>
					) : site.bio.length === 0 ? (
						<div aria-hidden="true" class="space-y-2.5">
							<span class="wire-line block w-full" />
							<span class="wire-line block w-11/12" />
							<span class="wire-line block w-2/3" />
						</div>
					) : null
				}
			</div>
			<div class="mt-10 flex flex-wrap items-center gap-3">
				<a href="/blog" class="btn-primary">Ir al blog</a>
				<a href="#proyectos" class="btn-secondary">Proyectos</a>
			</div>
		</div>

		<!-- Versículos destacados (RVC): rotación crossfade solo con CSS,
		     sin JavaScript. Con movimiento reducido queda fijo el primero. -->
		<div
			class="flex aspect-[4/3] flex-col rounded-xl border border-hairline bg-surface-card p-8 md:p-10"
			role="group"
			aria-label="Versículos destacados"
		>
			<div class="verse-stage relative flex-1">
				<figure class="verse verse-1">
					<blockquote class="font-display text-2xl leading-snug text-body-strong md:text-3xl">
						«Y conocerán la verdad, y la verdad los hará libres.»
					</blockquote>
					<figcaption class="mt-4 text-sm text-muted">Juan 8:32 · RVC</figcaption>
				</figure>
				<figure class="verse verse-2" aria-hidden="true">
					<blockquote class="font-display text-2xl leading-snug text-body-strong md:text-3xl">
						«Yo soy el camino, y la verdad, y la vida; nadie viene al Padre, sino por
						mí.»
					</blockquote>
					<figcaption class="mt-4 text-sm text-muted">Juan 14:6 · RVC</figcaption>
				</figure>
				<figure class="verse verse-3" aria-hidden="true">
					<blockquote class="font-display text-2xl leading-snug text-body-strong md:text-3xl">
						«Santifícalos en tu verdad; tu palabra es verdad.»
					</blockquote>
					<figcaption class="mt-4 text-sm text-muted">Juan 17:17 · RVC</figcaption>
				</figure>
			</div>
			<p class="mt-4 text-xs text-muted-soft">
				Reina Valera Contemporánea © 2009, 2011 Sociedades Bíblicas Unidas
			</p>
		</div>
	</div>
</section>
