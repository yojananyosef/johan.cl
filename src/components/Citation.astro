---
import type { CollectionEntry } from 'astro:content'
import { site } from '../data/site'

// Bloque "Cómo citar": nota + bibliografía Turabian en español («»),
// con botón copiar por formato y línea de licencia del contenido.
interface Props {
	post: CollectionEntry<'blog'>
}

const { post } = Astro.props
// URL canónica del artículo (coincide con el canonical de [slug].astro).
const citeUrl = `https://${site.domain}/blog/${post.id}`
// Días calendario del frontmatter: formatear en UTC para no retroceder el día.
const fmt = (d: Date) =>
	d.toLocaleDateString('es-CL', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
		timeZone: 'UTC',
	})
const pubLabel = fmt(post.data.pubDate)
const year = post.data.pubDate.getUTCFullYear()
const updatedLabel = post.data.updatedDate ? fmt(post.data.updatedDate) : null
---

<section
	aria-label="Cómo citar este artículo"
	class="mb-8 rounded-xl border border-hairline bg-surface-soft p-6"
>
	<h2 class="display-sm">Cómo citar este artículo</h2>

	<div data-cite-block class="mt-4">
		<h3 class="text-sm font-medium text-body-strong">Nota</h3>
		<p data-cite-text class="mt-1 text-sm leading-relaxed">
			{site.author.display}, «{post.data.title}», {site.domain}, {pubLabel},{' '}
			<a class="text-link break-all" href={citeUrl}>{citeUrl}</a>
		</p>
		<button
			type="button"
			data-copy-citation
			class="btn-secondary mt-2 h-8 px-3 text-xs"
		>
			Copiar nota
		</button>
	</div>

	<div data-cite-block class="mt-4">
		<h3 class="text-sm font-medium text-body-strong">Bibliografía</h3>
		<p data-cite-text class="mt-1 text-sm leading-relaxed">
			{site.author.last}, {site.author.first}. «{post.data.title}». {site.domain},{' '}
			{pubLabel}.{updatedLabel ? ` Actualizado el ${updatedLabel}.` : ''}{' '}
			<a class="text-link break-all" href={citeUrl}>{citeUrl}</a>
		</p>
		<button
			type="button"
			data-copy-citation
			class="btn-secondary mt-2 h-8 px-3 text-xs"
		>
			Copiar bibliografía
		</button>
	</div>

	<p class="mt-4 text-sm text-muted" aria-live="polite" data-copy-status hidden>
		Cita copiada al portapapeles.
	</p>
	<p class="mt-3 text-sm text-muted">
		© {year} {site.author.display}. Contenido bajo{' '}
		<a class="text-link" href={site.license.url} rel="license">
			{site.license.name}
		</a>{' '}
		(no comercial, sin derivados); la cita breve con atribución está permitida.
	</p>
</section>

<script is:inline>
	// Copiado con delegación en document (sobrevive a <ClientRouter />).
	document.addEventListener('click', (event) => {
		const button = event.target.closest('[data-copy-citation]');
		if (!(button instanceof HTMLButtonElement)) return;
		const block = button.closest('[data-cite-block]');
		const text = block?.querySelector('[data-cite-text]');
		if (!text) return;
		const plain = (text.textContent ?? '').replace(/\s+/g, ' ').trim();
		const done = () => {
			const section = button.closest('section');
			const status = section?.querySelector('[data-copy-status]');
			if (status instanceof HTMLElement) {
				status.hidden = false;
				window.setTimeout(() => {
					status.hidden = true;
				}, 2500);
			}
			const original = 'Copiar';
			if (!button.dataset.label) button.dataset.label = button.textContent ?? original;
			button.textContent = '¡Copiado!';
			window.setTimeout(() => {
				button.textContent = button.dataset.label ?? original;
			}, 2000);
		};
		if (navigator.clipboard?.writeText) {
			navigator.clipboard.writeText(plain).then(done).catch(() => {});
		} else {
			const area = document.createElement('textarea');
			area.value = plain;
			document.body.appendChild(area);
			area.select();
			try {
				document.execCommand('copy');
				done();
			} catch {
				/* portapapeles no disponible */
			}
			area.remove();
		}
	});
</script>
