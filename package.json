{
  "name": "johan.cl",
  "version": "1.0.0",
  "description": "Landing personal + blog técnico/teológico de Johan — Astro 7, Cloudflare Workers, Svelte 5, Bun",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --bun astro dev",
    "build": "astro build && pagefind --site dist/client",
    "preview": "bun --bun astro preview",
    "check": "wrangler types && bun --bun astro check",
    "lint": "bun x biome check src/",
    "types": "wrangler types",
    "deploy": "bun run build && bunx wrangler deploy && bunx wrangler deploy -c workers/www-redirect/wrangler.jsonc"
  },
  "keywords": [
    "astro",
    "cloudflare",
    "svelte",
    "blog"
  ],
  "author": "Johan Gutierrez",
  "license": "MIT",
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.6",
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/svelte": "^9.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.10",
    "bits-ui": "^2.19.0",
    "satori": "^0.33.4",
    "svelte": "^5.57.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.4.1",
    "pagefind": "^1.5.2",
    "typescript": "^6",
    "wrangler": "^4.128.0"
  }
}
